# Postgres connection string (required). Local example:
DATABASE_URL=postgres://hs:hs@localhost:5432/hs_dev
# Hosted example (Neon): pooled string for the app, direct string for the startup schema step
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

PORT=3000
# Public URL of this server, used in password-reset links
APP_URL=http://localhost:3000
# Set both when running behind HTTPS and a hosting proxy (Render, Fly, Heroku, nginx…)
# NODE_ENV=production
# TRUST_PROXY=1

# Email for password resets (https://resend.com, free tier). Without it, links are printed to the log.
# RESEND_API_KEY=
# MAIL_FROM="Help Seeker <no-reply@your-domain.com>"
# The owner's email: that confirmed account sees the "Sample data" card on the Account tab. Leave empty for no owner.
# ADMIN_EMAIL=
