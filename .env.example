# Postgres connection string (required). Local example:
DATABASE_URL=postgres://hs:hs@localhost:5432/hs_dev
# Hosted example (Neon/Supabase give you this string):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

PORT=3000
# Public URL of this server, used in password-reset links
APP_URL=http://localhost:3000
# Set both when running behind HTTPS and a hosting proxy (Render, Fly, Heroku, nginx…)
# NODE_ENV=production
# TRUST_PROXY=1

# Email for password resets (https://resend.com, free tier). Without it, links are printed to the log.
# RESEND_API_KEY=
# MAIL_FROM="Help Seeker <no-reply@your-domain.com>"
